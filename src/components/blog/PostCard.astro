---
import type { WPPost } from '../../types/wordpress'
import {
  getPostImageUrl,
  getPostCategories,
  getReadingTime,
  formatDate,
  stripHtml,
} from '../../lib/wordpress'

interface Props {
  post: WPPost
  featured?: boolean
}

const { post, featured = false } = Astro.props

const imageUrl = getPostImageUrl(post, featured ? 'large' : 'medium_large')
const imageAlt =
  post._embedded?.['wp:featuredmedia']?.[0]?.alt_text ||
  post.title.rendered
const categories = getPostCategories(post)
const firstCategory = categories[0]
const readingTime = getReadingTime(post)
const date = formatDate(post.date)
const rawExcerpt = stripHtml(post.excerpt.rendered)
const excerpt = rawExcerpt.length > (featured ? 200 : 120)
  ? rawExcerpt.slice(0, featured ? 200 : 120) + '…'
  : rawExcerpt
const title = post.title.rendered
---

<article class={`post-card${featured ? ' post-card--featured' : ''}`}>
  <a href={`/blog/${post.slug}/`} class="post-card__image-wrap" tabindex="-1" aria-hidden="true">
    <img
      src={imageUrl}
      alt={imageAlt}
      class="post-card__image"
      loading="lazy"
      decoding="async"
    />
    <div class="post-card__image-overlay"></div>
    {firstCategory && (
      <span class="post-card__category">{firstCategory.name}</span>
    )}
  </a>

  <div class="post-card__body">
    <a href={`/blog/${post.slug}/`} class="post-card__title-link">
      <h2 class="post-card__title" set:html={title} />
    </a>
    <p class="post-card__excerpt">{excerpt}</p>

    <footer class="post-card__footer">
      <span class="post-card__meta">
        {date}&ensp;·&ensp;{readingTime} min de leitura
      </span>
      <a href={`/blog/${post.slug}/`} class="post-card__read" aria-label={`Ler: ${title}`}>
        Ler →
      </a>
    </footer>
  </div>
</article>

<style>
  .post-card {
    background: #1A0F0A;
    border: 1px solid rgba(201, 168, 76, 0.2);
    border-radius: 6px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.35s ease, box-shadow 0.35s ease;
  }

  .post-card:hover {
    border-color: rgba(201, 168, 76, 0.6);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.4);
  }

  /* ── Imagem ──────────────────────────────────────────── */
  .post-card__image-wrap {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    flex-shrink: 0;
  }

  .post-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .post-card:hover .post-card__image {
    transform: scale(1.04);
  }

  .post-card__image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 55%,
      rgba(13, 8, 5, 0.85) 100%
    );
    pointer-events: none;
  }

  .post-card__category {
    position: absolute;
    bottom: 12px;
    left: 14px;
    background: rgba(13, 8, 5, 0.85);
    color: #C9A84C;
    font-family: 'Cinzel', serif;
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 2px;
  }

  /* ── Corpo ───────────────────────────────────────────── */
  .post-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 20px 22px 18px;
  }

  .post-card__title-link {
    text-decoration: none;
  }

  .post-card__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 20px;
    font-weight: 400;
    color: #E8D5A3;
    line-height: 1.3;
    margin-bottom: 10px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card__excerpt {
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    font-weight: 300;
    color: #A09080;
    line-height: 1.65;
    flex: 1;
    margin-bottom: 0;
  }

  /* ── Rodapé ──────────────────────────────────────────── */
  .post-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid rgba(201, 168, 76, 0.12);
    margin-top: 16px;
    padding-top: 12px;
    gap: 8px;
  }

  .post-card__meta {
    font-family: 'Jost', sans-serif;
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.06em;
    color: rgba(160, 144, 128, 0.7);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .post-card__read {
    font-family: 'Cinzel', serif;
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #C9A84C;
    white-space: nowrap;
    text-decoration: none;
    transition: letter-spacing 0.2s ease;
    flex-shrink: 0;
  }

  .post-card__read:hover {
    letter-spacing: 0.2em;
  }

  /* ── Variante featured ───────────────────────────────── */
  .post-card--featured .post-card__image-wrap {
    aspect-ratio: 16 / 7;
  }

  .post-card--featured .post-card__title {
    font-size: 26px;
    -webkit-line-clamp: 3;
  }

  /* Featured: lado a lado acima de 768px */
  @media (min-width: 768px) {
    .post-card--featured {
      flex-direction: row;
    }

    .post-card--featured .post-card__image-wrap {
      width: 58%;
      aspect-ratio: unset;
      flex-shrink: 0;
    }

    .post-card--featured .post-card__body {
      padding: 28px 28px 24px;
      justify-content: center;
    }

    .post-card--featured .post-card__title {
      font-size: clamp(22px, 2.4vw, 30px);
    }
  }

  /* Mobile */
  @media (max-width: 600px) {
    .post-card__body {
      padding: 16px 18px 14px;
    }

    .post-card__title {
      font-size: 18px;
    }
  }
</style>
