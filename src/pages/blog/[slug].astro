---
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import {
  getPosts,
  getPostImageUrl,
  getPostCategories,
  getReadingTime,
  formatDate,
} from '../../lib/wordpress'
import type { WPPost } from '../../types/wordpress'
import '../../styles/global.css'

export async function getStaticPaths() {
  const { posts } = await getPosts({ perPage: 50 })
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }))
}

interface Props { post: WPPost }
const { post } = Astro.props

const imageUrl    = getPostImageUrl(post, 'large')
const imageAlt    = post._embedded?.['wp:featuredmedia']?.[0]?.alt_text || post.title.rendered
const categories  = getPostCategories(post)
const readingTime = getReadingTime(post)
const date        = formatDate(post.date)
const title       = post.title.rendered

const seoTitle = post.yoast_head_json?.title ?? `${title} · Jady Mota`
const seoDesc  = post.yoast_head_json?.description ?? ''
const ogImage  = post.yoast_head_json?.og_image?.[0]?.url ?? imageUrl
---

<Layout title={seoTitle} description={seoDesc} ogImage={ogImage}>
  <Header />

  <main class="post-main">

    <!-- Hero do post -->
    <div class="post-hero">
      <img
        src={imageUrl}
        alt={imageAlt}
        class="post-hero__image"
        loading="eager"
        decoding="async"
      />
      <div class="post-hero__overlay"></div>
      <div class="post-hero__content container">
        <div class="post-hero__meta">
          {categories.map(cat => (
            <a href={`/blog/`} class="post-hero__cat">{cat.name}</a>
          ))}
        </div>
        <h1 class="post-hero__title" set:html={title} />
        <p class="post-hero__info">
          {date}&ensp;·&ensp;{readingTime} min de leitura
        </p>
      </div>
    </div>

    <!-- Conteúdo -->
    <div class="post-content container">
      <div class="post-body" set:html={post.content.rendered} />

      <!-- Rodapé do post -->
      <footer class="post-footer">
        <div class="post-footer__divider"></div>
        <a href="/blog/" class="post-footer__back">← Voltar aos artigos</a>
      </footer>
    </div>

  </main>

  <Footer />
</Layout>

<style>
  /* ── Layout ──────────────────────────────────────────── */
  .post-main {
    background: var(--bg-primary);
    min-height: 100vh;
  }

  /* ── Hero ────────────────────────────────────────────── */
  .post-hero {
    position: relative;
    height: clamp(320px, 50vw, 560px);
    overflow: hidden;
  }

  .post-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: brightness(0.75);
  }

  .post-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(13, 8, 5, 0.3) 0%,
      rgba(13, 8, 5, 0.7) 70%,
      rgba(13, 8, 5, 0.95) 100%
    );
  }

  .post-hero__content {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    padding-bottom: clamp(32px, 5vw, 56px);
  }

  .post-hero__meta {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .post-hero__cat {
    font-family: 'Cinzel', serif;
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    text-decoration: none;
    background: rgba(13, 8, 5, 0.7);
    padding: 5px 12px;
    border-radius: 2px;
    transition: color 0.2s ease;
  }

  .post-hero__cat:hover {
    color: var(--gold-soft);
  }

  .post-hero__title {
    font-family: 'Cinzel', serif;
    font-size: clamp(24px, 4vw, 42px);
    font-weight: 400;
    color: var(--gold-soft);
    line-height: 1.25;
    letter-spacing: 0.02em;
    margin-bottom: 16px;
    max-width: 800px;
  }

  .post-hero__info {
    font-family: 'Jost', sans-serif;
    font-size: 12px;
    font-weight: 300;
    letter-spacing: 0.08em;
    color: rgba(160, 144, 128, 0.8);
  }

  /* ── Conteúdo ────────────────────────────────────────── */
  .post-content {
    padding-top: clamp(48px, 7vw, 80px);
    padding-bottom: clamp(80px, 12vw, 140px);
  }

  .post-body {
    max-width: 720px;
    margin: 0 auto;
  }

  /* Estilos do conteúdo WordPress */
  .post-body :global(p) {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(17px, 1.5vw, 20px);
    font-weight: 300;
    line-height: 1.9;
    color: var(--text);
    margin-bottom: 1.5em;
  }

  .post-body :global(h2) {
    font-family: 'Cinzel', serif;
    font-size: clamp(18px, 2vw, 24px);
    font-weight: 400;
    color: var(--gold-soft);
    letter-spacing: 0.04em;
    margin: 2.4em 0 0.8em;
    line-height: 1.3;
  }

  .post-body :global(h3) {
    font-family: 'Cinzel', serif;
    font-size: clamp(15px, 1.6vw, 19px);
    font-weight: 400;
    color: var(--gold-soft);
    letter-spacing: 0.03em;
    margin: 2em 0 0.6em;
  }

  .post-body :global(strong) {
    font-weight: 400;
    color: var(--gold-soft);
  }

  .post-body :global(em) {
    font-style: italic;
    color: rgba(232, 213, 163, 0.85);
  }

  .post-body :global(a) {
    color: var(--gold);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .post-body :global(a:hover) {
    color: var(--gold-soft);
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 0 0 1.5em 1.6em;
  }

  .post-body :global(li) {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(17px, 1.5vw, 20px);
    font-weight: 300;
    line-height: 1.8;
    color: var(--text);
    margin-bottom: 0.4em;
  }

  .post-body :global(blockquote) {
    border-left: 2px solid rgba(201, 168, 76, 0.5);
    margin: 2em 0;
    padding: 4px 0 4px 24px;
  }

  .post-body :global(blockquote p) {
    font-style: italic;
    color: var(--gold-soft);
    font-size: clamp(18px, 1.7vw, 22px);
  }

  .post-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 4px;
    margin: 2em auto;
    display: block;
  }

  .post-body :global(hr) {
    border: none;
    border-top: 1px solid rgba(201, 168, 76, 0.2);
    margin: 3em 0;
  }

  .post-body :global(code) {
    font-family: monospace;
    font-size: 0.85em;
    background: rgba(201, 168, 76, 0.08);
    color: var(--gold-soft);
    padding: 2px 6px;
    border-radius: 2px;
  }

  /* ── Rodapé do post ──────────────────────────────────── */
  .post-footer {
    max-width: 720px;
    margin: 0 auto;
    padding-top: 48px;
  }

  .post-footer__divider {
    width: 100%;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      rgba(201, 168, 76, 0.35) 30%,
      rgba(201, 168, 76, 0.35) 70%,
      transparent
    );
    margin-bottom: 32px;
  }

  .post-footer__back {
    font-family: 'Jost', sans-serif;
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
    text-decoration: none;
    transition: letter-spacing 0.2s ease;
  }

  .post-footer__back:hover {
    letter-spacing: 0.18em;
  }
</style>
